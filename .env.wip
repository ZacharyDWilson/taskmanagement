# Shareable preview build (npm run build:wip): admin look, demo data, fake in-memory backend, no real server.
# The Supabase values are blanked on purpose so the real project address never ends up in this build.
VITE_APP_MODE=admin
VITE_DEMO_DATA=true
VITE_FAKE_BACKEND=true
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
